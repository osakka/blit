#!/usr/bin/env hibr
strict
# Neither session kind may inherit the private handoff sender or admin token.
leaked=0
for path in /proc/self/fd/*; do
    link=$(/usr/bin/readlink "$path") || continue
    [ "$link" != "$BLIT_GATE_SENDER_INODE" ] || leaked=1
done
# The fourth field: a desktop is told the password was just given (so a
# resumed one shows no saver or lock); a shell is not.
printf '%s:%s:%s:%s\n' "$leaked" "${BLIT_API_TOKEN-absent}" "$EUID" \
    "${HIBR_SIGNEDIN-absent}" > "$BLIT_GATE_RESULT"
if [ -n "${BLIT_GATE_OWNER_FILE-}" ]; then
    if [ -n "${BLIT_GATE_OWNER_DELAY-}" ]; then
        /bin/sleep "$BLIT_GATE_OWNER_DELAY"
    fi
    printf '%s\n' "$$" > "$BLIT_GATE_OWNER_FILE"
fi
exec /bin/sleep 30
