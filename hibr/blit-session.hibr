#!/usr/bin/env hibr
# Blit's ordinary-console Hibr entrypoint.
#
# This entrypoint is used for held desktop sessions.  Hibr's native console
# provider writes the primary desktop to its PTY; Blit parses that stream.
# A --join process is only Hibr's hold client: hold renders that client's own
# viewport to its PTY, and Blit parses that PTY into the joined pane.  This is
# the only path that preserves Hibr's union-grid, wallpaper, graphics, and
# input semantics without creating a second desktop state owner.
#
# The optional api provider is retained for explicit standalone integration
# tests.  It must be paired with surface_mode=external by the API client and
# is never selected by this packaged desktop entrypoint.

launcher_dir=${0%/*}
[ "$launcher_dir" = "$0" ] && launcher_dir=.
moddir=${BLIT_HIBR_MODPATH:-}
if [ -z "$moddir" ] && [ -d "$launcher_dir/mods" ]; then
	moddir=$launcher_dir/mods
fi
if [ -z "$moddir" ]; then
	moddir=/usr/lib/hibr
fi
adapter=${BLIT_HIBR_ADAPTER:-/usr/lib/blit/hibr/console-blit.so}
provider=${BLIT_HIBR_PROVIDER:-terminal}
desktop=${BLIT_HIBR_DESKTOP_SESSION:-}
blit_join=0
blit_session=desktop
blit_name=
blit_expect=
for argument in "$@"; do
	if [ -n "$blit_expect" ]; then
		case "$blit_expect" in
			session) blit_session=$argument ;;
			name) blit_name=$argument ;;
		esac
		blit_expect=
		continue
	fi
	case "$argument" in
		--join|-j) blit_join=1 ;;
		--session=*) blit_session=${argument#--session=} ;;
		--name=*) blit_name=${argument#--name=} ;;
		--session|-s) blit_expect=session ;;
		--name|-n) blit_expect=name ;;
	esac
done
if [ -z "$desktop" ] && [ -f "$launcher_dir/session.hibr" ]; then
	desktop=$launcher_dir/session.hibr
fi
if [ -z "$desktop" ]; then
	desktop=/usr/share/hibr/desktop/session.hibr
fi

if [ ! -f "$desktop" ]; then
	lg HIBR_LERR "blit-session: desktop session not found: $desktop"
	exit 1
fi
# Hibr's held desktop creates interactive children that read HIBR_RC.  Supply
# the installed Blit RC when the caller did not provide one; QEMU and other
# controlled fixtures retain their explicit RC and therefore keep their own
# staged module paths.
runtime_rc=${BLIT_HIBR_RUNTIME_RC:-$launcher_dir/blit-runtime-console.hibr}
if [ -z "${HIBR_RC:-}" ] && [ -f "$runtime_rc" ]; then
	export HIBR_RC=$runtime_rc
fi
# Hibr's root login boundary intentionally starts the authenticated command
# with a clean environment. Reassert the Blit terminal contract here, after
# that boundary, so the desktop does not silently fall back to half blocks.
# Keep explicit caller values: API sessions may deliberately select `sixel`,
# `off`, or a different bidi policy for a controlled compatibility test.
export DT_BIDI=${DT_BIDI:-on}
export HIBR_GFX=${HIBR_GFX:-kitty}
export COLORTERM=${COLORTERM:-truecolor}
# The terminal-provider desktop must be executed with Hibr's installed session
# as the script entrypoint. Hibr's session resolves its sibling desktop.hibr
# from $0; sourcing it through this wrapper would leave $0 pointing at Blit's
# launcher and redirect that import into /usr/share/blit/hibr. Executing the
# installed script preserves Hibr's native relative-import semantics without a
# mirrored integration tree. The terminal provider is intentionally native:
# Blit parses the PTY stream, so this process does not need the API adapter.
export HIBR_MODPATH=${HIBR_MODPATH:-$moddir}
if [ "$provider" = "api" ] && [ "$blit_join" = 0 ]; then
	mod load "$adapter" || exit 1
fi
if [ "$provider" != "terminal" ] &&
   [ "$provider" != "api" ]; then
	echo "$0: BLIT_HIBR_PROVIDER must be terminal or api" >&2
	exit 1
fi
mod load "$moddir/img.so" || exit 1
mod load "$moddir/pty.so" || exit 1
mod load "$moddir/term.so" || exit 1
mod load "$moddir/hold.so" || exit 1
# Blit keeps physical pane placement separate from Hibr's horizontal desktop
# union. The primary stays at logical (0,0), and the server supplies a stable
# logical column for each join. This remains in the Blit-owned launcher so
# Hibr's desktop implementation is untouched; without these variables, retain
# Hibr's stock behavior for direct Hibr invocations and other controlled uses
# of this entrypoint.
if [ "$blit_join" = 1 ] &&
	[ -n "${BLIT_HIBR_PANE_ROW:-}" ] &&
	[ -n "${BLIT_HIBR_PANE_COL:-}" ] &&
	[ -n "${BLIT_HIBR_PRIMARY_ROW:-}" ] &&
	[ -n "${BLIT_HIBR_PRIMARY_COL:-}" ]; then
	blit_clients=$(hold clients "$blit_session") || exit 1
	blit_primary_client=
	while IFS=' ' read -r blit_client blit_row blit_col blit_rows \
		blit_cols blit_primary; do
		[ "$blit_primary" = 1 ] || continue
		blit_primary_client=$blit_client
		break
	done <<< "$blit_clients"
	if [ -z "$blit_primary_client" ]; then
		echo "$0: no primary client in held session $blit_session" >&2
		exit 1
	fi
	# Reassert the primary's canonical logical origin only when it has actually
	# been rearranged through Hibr's control panel. A no-op `hold move` clears
	# Hibr's client front buffer and would turn a correct primary into a partial
	# repaint during the join handshake.
	if [ "$BLIT_HIBR_PRIMARY_ROW" != 0 ] ||
		[ "$BLIT_HIBR_PRIMARY_COL" != 0 ]; then
		hold move "$blit_session" "$blit_primary_client" \
			"$BLIT_HIBR_PRIMARY_ROW" "$BLIT_HIBR_PRIMARY_COL" || exit 1
	fi
	if [ -n "$blit_name" ]; then
		hold attach -m -n "$blit_name" "$blit_session" \
			"$BLIT_HIBR_PANE_ROW" "$BLIT_HIBR_PANE_COL"
	else
		hold attach -m "$blit_session" \
			"$BLIT_HIBR_PANE_ROW" "$BLIT_HIBR_PANE_COL"
	fi
	exit $?
fi
# Open Blit's provider before the stock desktop enters its held-session
# transition. The initial launcher remains the ownership-scoped Hibr client;
# relying on the detached child's later `need display` can allow Hibr's native
# console provider to win before the Blit adapter is opened.
if [ "$provider" = "api" ] && [ "$blit_join" = 0 ]; then
	console open || exit 1
fi
# Hibr's stock desktop defaults DT_TERMMS to 70 ms, which is suitable for a
# local terminal but caps program-driven redraws below a display refresh.
# Blit's scheduler already applies the display's refresh interval, so remove
# that second throttle by default while preserving an explicit caller choice.
DT_TERMMS=${DT_TERMMS-0}
if [ "$provider" = "terminal" ]; then
	exec "$HIBR" "$desktop" "$@"
fi
source "$desktop" "$@"
