#!/usr/bin/env hibr
# Blit's ordinary-console Hibr entrypoint.
#
# This entrypoint is used for held desktop sessions.  The primary process
# loads Blit's display provider and is the one desktop writer.  A --join
# process is only Hibr's hold client: hold renders that client's own viewport
# to its PTY, and Blit parses that PTY into the joined pane.  Do not open a
# second Blit display provider for a join; doing so makes it look like a
# second desktop owner and bypasses hold's union-grid semantics.

d=${0%/*}
[ "$d" = "$0" ] && d=.
moddir=${BLIT_HIBR_MODPATH:-}
if [ -z "$moddir" ] && [ -d "$d/mods" ]; then
	moddir=$d/mods
fi
if [ -z "$moddir" ]; then
	moddir=/usr/lib/hibr
fi
adapter=${BLIT_HIBR_ADAPTER:-/usr/lib/blit/hibr/console-blit.so}
desktop=${BLIT_HIBR_DESKTOP_SESSION:-}
blit_join=0
for argument in "$@"; do
	case "$argument" in
		--join|-j) blit_join=1 ;;
	esac
done
if [ -z "$desktop" ] && [ -f "$d/session.hibr" ]; then
	desktop=$d/session.hibr
fi
if [ -z "$desktop" ]; then
	desktop=/usr/share/hibr/desktop/session.hibr
fi

if [ ! -f "$desktop" ]; then
	lg HIBR_LERR "blit-session: desktop session not found: $desktop"
	exit 1
fi
# Hibr's held desktop creates interactive children that read HIBR_RC.  Supply
# the installed Blit RC when the caller did not provide one; QEMU and other
# controlled fixtures retain their explicit RC and therefore keep their own
# staged module paths.
runtime_rc=${BLIT_HIBR_RUNTIME_RC:-$d/blit-runtime-console.hibr}
if [ -z "${HIBR_RC:-}" ] && [ -f "$runtime_rc" ]; then
	export HIBR_RC=$runtime_rc
fi
# Run the real desktop file in this same Hibr process.  The launcher RC loads
# the optional Blit provider before this entrypoint; exec-ing a second Hibr process here
# would discard that provided display interface before desktop.hibr starts.
# The Debian package supplies symlinks for Hibr's sibling desktop tree beside
# this launcher, preserving the stock session's relative-import semantics.
export HIBR_MODPATH=${HIBR_MODPATH:-$moddir}
if [ "$blit_join" = 0 ]; then
	mod load "$adapter" || exit 1
fi
mod load "$moddir/img.so" || exit 1
mod load "$moddir/pty.so" || exit 1
mod load "$moddir/term.so" || exit 1
mod load "$moddir/hold.so" || exit 1
# Open Blit's provider before the stock desktop enters its held-session
# transition. The initial launcher remains the ownership-scoped Hibr client;
# relying on the detached child's later `need display` can allow Hibr's native
# console provider to win before the Blit adapter is opened.
if [ "$blit_join" = 0 ]; then
	console open || exit 1
fi
# Hibr's stock desktop defaults DT_TERMMS to 70 ms, which is suitable for a
# local terminal but caps program-driven redraws below a display refresh.
# Blit's scheduler already applies the display's refresh interval, so remove
# that second throttle by default while preserving an explicit caller choice.
DT_TERMMS=${DT_TERMMS-0}
source "$desktop" "$@"
