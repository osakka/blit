# Production Hibr startup file for Blit-owned desktop children.
#
# Hibr reads HIBR_RC in interactive child shells.  The QEMU fixtures provide
# their own fixture-specific RC; this file is the installed equivalent.
# The parent Blit entrypoint already loads Hibr's native support modules, so
# this child RC must load only the Blit adapter and must not duplicate them.
# It does not modify Hibr or replace Hibr's desktop/session files.

adapter=${BLIT_HIBR_ADAPTER:-/usr/lib/blit/hibr/console-blit.so}
moddir=${BLIT_HIBR_MODPATH:-/usr/lib/hibr}

mod load "$adapter" || exit 1
