#!/usr/bin/env hibr
# Blit-owned live integration probe. It exercises Hibr's image provider through
# the installed Blit display adapter without changing Hibr source or desktop
# state. The image path is part of the installed Hibr desktop tree.

mod load /usr/lib/hibr/console-blit.so || exit 1
mod load /usr/lib/hibr/img.so || exit 1
console open || exit 1
img draw /usr/share/hibr/desktop/themes/retro_car.png 0 0 32 64 -u || exit 1
console flush || exit 1
sleep 1
