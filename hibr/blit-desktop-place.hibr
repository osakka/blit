#!/usr/bin/env hibr
# ADR 0128: one guarded native move, as the authenticated desktop user.
strict
base=${1-}
anchor=${2-}
client=${3-}
owner=${4-}
ticks=${5-}
dr=${6-}
dc=${7-}
for name in "$base" "$anchor" "$client"; do
    case "$name" in ''|.*|*[!a-zA-Z0-9_.:-]*) exit 2 ;; esac
    [ "${#name}" -le 63 ] || exit 2
done
for number in "$owner" "$ticks"; do
    case "$number" in ''|*[!0-9]*) exit 2 ;; esac
done
for number in "$dr" "$dc"; do
    number=${number#-}
    case "$number" in ''|*[!0-9]*) exit 2 ;; esac
done
mod load pty || exit 1
mod load term || exit 1
mod load hold || exit 1
line := /bin/cat "/proc/$owner/stat" || exit 1
rest=${line##*) }
read -ra fields <<< "$rest"
[ "${fields[19]}" = "$ticks" ] || exit 1
list := hold list || exit 1
matched=0
while read -r name status pid size extra; do
    [ "$name" = "$base" ] || continue
    [ "$pid" = "$owner" ] && [ -z "$extra" ] || exit 1
    matched=1
done <<< "$list"
[ "$matched" = 1 ] || exit 1
clients := hold clients "$base" || exit 1
found_anchor=0
found_client=0
primary_count=0
while read -r name row col rows cols primary extra; do
    [ "$name" = "$anchor" ] && { ar=$row; ac=$col; found_anchor=1; }
    [ "$name" = "$client" ] && found_client=1
    if [ "$primary" = 1 ]; then
        pr=$row; pc=$col
        primary_count=$((primary_count + 1))
    fi
done <<< "$clients"
[ "$found_anchor" = 1 ] && [ "$found_client" = 1 ] && [ "$primary_count" = 1 ] || exit 1
# Native union normalization can change absolute origins. Anchor the initial
# placement to the verified login client, then translate to hold move's frame
# relative to the independently selected native primary. Do not promote it.
hold move "$base" "$client" "$((ar + dr - pr))" "$((ac + dc - pc))"
