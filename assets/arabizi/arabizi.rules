# Blit Arabizi rules (draft). One source of truth: the engine reads this; the
# tuning layer (the user's own words) uses the same format.
#
#   unit   <latin> <position> <options>     options: comma-separated, the first
#                                           the default; "-" is silent
#   long   <latin> <position> <options>     a long vowel or diphthong
#   phrase <latin words...> = <arabic>      a whole phrase, matched first
#   word   <latin> = <arabic>               one word, always (names, the user's)
#   article <latin> ...                     the article ال, joined to the next word
#   conj    <latin> ...                     و, joined to the next word
#   punct  <latin> <arabic>
#
# position: any | initial | medial | final.  A line for a position overrides
# the "any" line for that unit there.
#
# Tashkeel: each vowel option may carry the haraka it writes when silent in
# tashkeel mode, as -:<mark> (fatha َ, kasra ِ, damma ُ).

# Digits and their dotted forms (core convention; Wikipedia "Arabic chat
# alphabet"). 8 is ق by default (Gulf); غ in Lebanon is the second option.
unit 2' any ئ
unit 3' any غ
unit 5' any خ
unit 6' any ظ
unit 7' any خ
unit 9' any ض
unit 2 initial أ,إ,ا,ء,ق
unit 2 medial ء,أ,ئ,ؤ,ق
unit 2 final ء,أ,ئ
unit 3 any ع
unit 5 any خ
unit 6 any ط
unit 7 any ح
unit 8 any ق,غ
unit 9 any ص,ق
unit ' any ع,ء,-

# Digraphs.
unit sh any ش
unit kh any خ
unit gh any غ
unit th any ث,ذ,ظ
unit dh any ذ,ض,ظ
unit ch any ش

# Consonants.
unit b any ب
unit p any ب
unit t any ت,ط
unit j any ج
unit g any ج,غ,ق
unit d any د,ض
unit r any ر
unit z any ز,ظ
unit s any س,ص
unit f any ف
unit v any ف
unit q any ق
unit k any ك
unit l any ل
unit m any م
unit n any ن
unit h any ه,ح
unit w any و
unit y any ي,ى
unit x any كس
unit c any ك

# Short vowels: silent inside a word or long; at the start a seat; at the end
# never silent unless a case ending (u, i, a after a consonant).
unit a initial ا,أ,آ,إ,ع
unit a medial -:َ,ا
unit a final ا,ة,ى,ه,-:َ
unit e initial ا,إ,أ,ع
unit e medial -:ِ,ي
unit e final ة,ي,ه
unit i initial ا,إ,أ
unit i medial -:ِ,ي
unit i final ي,-:ِ
unit o initial ا,أو,أ
unit o medial -:ُ,و
unit o final و
unit u initial ا,أو,أ
unit u medial -:ُ,و
unit u final و,-:ُ

# Long vowels and diphthongs.
long aa initial آ,ا,ع
long aa any ا
long ee any ي
long ii any ي
long oo any و
long uu any و
long ou any و
long ei any ي
long ai any ي
long ay any ي
long aw any و
long ow any و
long ee initial اي,إي
long ei initial اي,أي
long ai initial اي,أي
long ay initial اي,أي
long ii initial اي,إي

# Endings: -an may be tanween (ahlan أهلا); -eh/-ah the taa marbuta.
ending an final ان,ا:ً
ending eh final ة,ه
ending ah final ة,ه,اه

# Joined words.
article el al il l
conj wa w ou o

# Phrases (the commonest fixed expressions).
phrase in sha2 allah = إن شاء الله
phrase inshallah = إن شاء الله
phrase inshalla = إن شاء الله
phrase ma sha2 allah = ما شاء الله
phrase mashallah = ما شاء الله
phrase alhamdulillah = الحمد لله
phrase al7amdulillah = الحمد لله
phrase el7amdella = الحمدلله
phrase bismillah = بسم الله
phrase allah = الله
phrase allahu = الله
phrase yalla = يلا

punct ? ؟
punct , ،
punct ; ؛
